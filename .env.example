# Copy to .env in the root and/or in services/price-ingest-service, as needed.
# Never commit a real .env file.

# --- price-ingest-service ---

# Bearer token for https://api.openelectricity.org.au/v4
OPENELECTRICITY_API_KEY=

# Overridable for testing against a mock server; defaults to the real API.
OPENELECTRICITY_BASE_URL=https://api.openelectricity.org.au/v4

# NEM region to poll (VIC, NSW, QLD, SA, TAS).
REGION=VIC

# AUD/MWh price above which a PriceSpikeDetected event is emitted.
SPIKE_THRESHOLD=300

# How often to poll for new price intervals, in milliseconds.
# NEM dispatch prices settle every 5 minutes, so 300000 lines up with that.
POLL_INTERVAL_MS=300000

# Path to a historical AEMO price CSV, used when the live API is unreachable.
CSV_FALLBACK_PATH=./data/historical-prices.csv

# --- MQTT (shared by price-ingest-service and simulator) ---

MQTT_URL=mqtt://localhost:1883
