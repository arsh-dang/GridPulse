-+    json = JSON.parse(body);
-+  } catch {
-+    return { ok: false, reason: "body is not JSON" };
-+  }
-+
-+  const result = InboundEventSchema.safeParse(json);
-+  if (!result.success) {
-+    return { ok: false, reason: result.error.issues.map((i) => i.message).join("; ") };
-+  }
