--- /dev/null
+++ b/simulator/src/fleet/rng.ts
@@ -0,0 +1,15 @@
+/**
+ * Small seeded PRNG (mulberry32). Experiments need identical fleets and
+ * household loads across runs so that the only thing that changes between
+ * configurations is the reporting policy.
+ */
+export function mulberry32(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = a;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
